{
  "$schema": "https://openclaw.ai/schema/config.json",
  "agent": {
    "name": "Astra",
    "description": "Personal AI assistant for task management, expense tracking, habits, and calendar",
    "personality": "You are Astra, a helpful and efficient personal assistant. You communicate primarily in English but understand Hebrew. You are proactive, concise, and always use your tools to take action rather than just talking."
  },
  "model": {
    "provider": "ollama",
    "base_url": "http://localhost:11434",
    "model": "hermes3:8b-llama3.1-q8_0",
    "fallback_model": "hermes3",
    "temperature": 0.7,
    "max_tokens": 2048
  },
  "channels": {
    "whatsapp": {
      "enabled": false,
      "adapter": "whatsapp-baileys",
      "config": {
        "auth_dir": "./data/whatsapp_auth"
      }
    },
    "cli": {
      "enabled": true,
      "adapter": "cli",
      "config": {
        "prompt": "You > "
      }
    }
  },
  "knowledge": {
    "directories": ["./knowledge"],
    "file_extensions": [".md"],
    "index_on_startup": true
  },
  "skills": {
    "directory": "./skills"
  },
  "tools": {
    "custom_directory": "./tools",
    "allowed": [
      "get_current_time",
      "add_task",
      "list_tasks",
      "complete_task",
      "delete_task",
      "add_recurring_task",
      "list_recurring_tasks",
      "remove_recurring_task",
      "add_expense",
      "get_expense_summary",
      "add_income",
      "get_financial_overview",
      "set_budget",
      "list_budgets",
      "check_budget_alerts",
      "add_calendar_event",
      "list_calendar_events",
      "track_habit",
      "log_habit",
      "list_habits",
      "get_daily_status",
      "web_search",
      "propose_new_fact",
      "approve_fact",
      "list_whatsapp_media",
      "list_recent_emails",
      "read_email",
      "get_email_digest",
      "text_to_speech",
      "immich_stats",
      "immich_search_photos",
      "immich_list_albums",
      "immich_create_album",
      "immich_add_to_album"
    ]
  },
  "scheduler": {
    "timezone": "Asia/Jerusalem",
    "heartbeats": [
      {
        "name": "morning_briefing",
        "cron": "0 8 * * *",
        "skill": "daily_briefing",
        "message": "Generate the morning briefing."
      },
      {
        "name": "evening_summary",
        "cron": "0 20 * * *",
        "skill": "daily_briefing",
        "message": "Generate the evening summary."
      },
      {
        "name": "recurring_tasks",
        "cron": "0 7 * * *",
        "skill": "task_management",
        "message": "Generate any due recurring tasks for today."
      },
      {
        "name": "email_digest",
        "cron": "0 9,17 * * *",
        "skill": "media_access",
        "message": "Check for new emails and provide a brief digest."
      },
      {
        "name": "budget_check",
        "cron": "0 12 * * *",
        "skill": "expense_tracking",
        "message": "Check budget alerts and notify if any category is near or over the monthly limit."
      },
      {
        "name": "photo_organizer",
        "cron": "0 */6 * * *",
        "skill": "photo_management",
        "message": "Organize any new unprocessed photos."
      }
    ]
  },
  "storage": {
    "type": "sqlite",
    "path": "./data/memory.db"
  }
}
