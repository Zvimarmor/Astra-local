# ─── Astra Local Agent Environment ───────────────────────────

# Owner phone number (for WhatsApp authorization)
OWNER_PHONE_NUMBER=972XXXXXXXXX

# Google Calendar ID (shared with the service account)
CALENDAR_ID=your_calendar_id@group.calendar.google.com

# Path to Google service account JSON (relative to project root)
SERVICE_ACCOUNT_PATH=data/service_account.json

# Ollama endpoint (local)
OLLAMA_BASE_URL=http://localhost:11434

# Ollama model to use
OLLAMA_MODEL=nous-hermes

# Timezone
TIMEZONE=Asia/Jerusalem

# Optional: Whitelist additional WhatsApp JIDs (comma-separated)
WHITELIST_JIDS=
