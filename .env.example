# ─── Astra Local Agent Environment ───────────────────────────

# Owner phone number (for WhatsApp authorization)
OWNER_PHONE_NUMBER=972XXXXXXXXX

# Google Calendar ID (shared with the service account)
CALENDAR_ID=your_calendar_id@group.calendar.google.com

# Path to Google service account JSON (relative to project root)
SERVICE_ACCOUNT_PATH=data/service_account.json

# ─── Gemini API (cloud inference — replaced local Ollama) ───
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Free-tier flash alias. NOTE: gemini-1.5-flash and gemini-2.5-flash are
# retired for new keys (404 "no longer available to new users").
GEMINI_MODEL=gemini-flash-latest

# Per-attempt request timeout (ms)
GEMINI_TIMEOUT_MS=60000

# Timezone
TIMEZONE=Asia/Jerusalem

# Optional: Whitelist additional WhatsApp JIDs (comma-separated)
WHITELIST_JIDS=

# ─── Email (IMAP read-only — no SMTP, cannot send) ───
# For Gmail, use an App Password (requires 2FA enabled):
#   https://myaccount.google.com/apppasswords

# Personal Gmail
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=your_personal_email@gmail.com
IMAP_PASSWORD=your_app_password

# University Gmail
IMAP_HOST_UNI=imap.gmail.com
IMAP_PORT_UNI=993
IMAP_USER_UNI=your_university_email@university.ac.il
IMAP_PASSWORD_UNI=your_uni_app_password

# ─── Piper TTS (Local Text-to-Speech) ───
PIPER_BINARY_PATH=/opt/homebrew/bin/piper
PIPER_VOICE_MODEL=~/piper-voices/en-us-amy-medium.onnx

# ─── Dashboard (Health Check) ───
DASHBOARD_PORT=3001
# Generate with: openssl rand -hex 16
DASHBOARD_TOKEN=

# ─── Spotify (Premium) — playback control via spotifyd ───
# Create an app at https://developer.spotify.com/dashboard,
# add redirect URI http://127.0.0.1:8888/callback, then run:
#   node scripts/spotify-auth.mjs   (prints SPOTIFY_REFRESH_TOKEN)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=
SPOTIFY_DEVICE_NAME=Astra_Mac_Mini

# ─── Telegram (proactive scheduler → Bot API) ───
# Bot token from @BotFather (also in ~/.openclaw/openclaw.json).
# Owner chat id = your numeric Telegram user id (the scheduler DMs you here).
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=

# ─── Scheduler (proactive automations) ───
SCHEDULER_TICK_SECONDS=60
SCHEDULER_QUIET_NIGHT_START=22
SCHEDULER_QUIET_NIGHT_END=7
SCHEDULER_QUIET_SHABBAT=true
SCHEDULER_SHABBAT_START_FRI=18
SCHEDULER_SHABBAT_END_SAT=20

# ─── Out-of-band alerts (scheduler channel watchdog) ───────────────────
# The watchdog polls the WhatsApp channel and, when it is down, alerts via
# carriers that do NOT depend on WhatsApp: Telegram Bot API + SMTP email.
ALERT_EMAIL=you@example.com

# SMTP (send-side; normal email access is read-only IMAP above).
# Gmail: use an app password — https://myaccount.google.com/apppasswords
# Blank SMTP_USER/SMTP_PASSWORD fall back to IMAP_USER/IMAP_PASSWORD.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Watchdog tuning.
#   PROBE_MIN       how often to probe channel health
#   FAILURES        consecutive failed probes before alerting (debounces restarts)
#   REMINDER_HOURS  0 = exactly one alert per outage; >0 = re-nag every N hours
SCHEDULER_WATCHDOG=true
SCHEDULER_WATCHDOG_PROBE_MIN=5
SCHEDULER_WATCHDOG_FAILURES=3
SCHEDULER_WATCHDOG_REMINDER_HOURS=0
