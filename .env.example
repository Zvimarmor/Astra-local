# ─── Astra Local Agent Environment ───────────────────────────

# Owner phone number (for WhatsApp authorization)
OWNER_PHONE_NUMBER=972XXXXXXXXX

# Google Calendar ID (shared with the service account)
CALENDAR_ID=your_calendar_id@group.calendar.google.com

# Path to Google service account JSON (relative to project root)
SERVICE_ACCOUNT_PATH=data/service_account.json

# Ollama endpoint (local)
OLLAMA_BASE_URL=http://localhost:11434

# Ollama model to use
OLLAMA_MODEL=nous-hermes

# Timezone
TIMEZONE=Asia/Jerusalem

# Optional: Whitelist additional WhatsApp JIDs (comma-separated)
WHITELIST_JIDS=

# ─── Email (IMAP read-only — no SMTP, cannot send) ───
# For Gmail, use an App Password (requires 2FA enabled):
#   https://myaccount.google.com/apppasswords

# Personal Gmail
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=your_personal_email@gmail.com
IMAP_PASSWORD=your_app_password

# University Gmail
IMAP_HOST_UNI=imap.gmail.com
IMAP_PORT_UNI=993
IMAP_USER_UNI=your_university_email@university.ac.il
IMAP_PASSWORD_UNI=your_uni_app_password

# ─── Piper TTS (Local Text-to-Speech) ───
PIPER_BINARY_PATH=/opt/homebrew/bin/piper
PIPER_VOICE_MODEL=~/piper-voices/en-us-amy-medium.onnx

# ─── Dashboard (Health Check) ───
DASHBOARD_PORT=3001
# Generate with: openssl rand -hex 16
DASHBOARD_TOKEN=
